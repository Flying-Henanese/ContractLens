# 对外 API 端口
API_PORT=8880

# PaddleOCR 官方华为昇腾镜像。离线环境可改为 latest-huawei-npu-offline。
ASCEND_API_IMAGE_TAG=latest-huawei-npu
ASCEND_VLM_IMAGE_TAG=latest-huawei-npu

# 宿主机 PaddleX 模型缓存目录。
PADDLEX_CACHE_DIR=/home/mineru_dev/.paddlex

# Pipeline 使用的物理 NPU。
PIPELINE_NPU_ID=7

# VLM 使用的物理 NPU，数量必须与 VLM_DATA_PARALLEL_SIZE 一致。
VLM_NPU_IDS=4,5,6
VLM_DATA_PARALLEL_SIZE=3
VLM_DATA_PARALLEL_BACKEND=mp

VLM_MODEL=PaddleOCR-VL-1.6-0.9B
# vLLM 沿用 gpu-memory-utilization 参数名，在昇腾上表示 NPU HBM 使用比例。
VLM_GPU_MEMORY_UTILIZATION=0.3
VLM_MAX_NUM_SEQS=16
VLM_MAX_NUM_BATCHED_TOKENS=16384

# 首次下载或加载模型可能耗时较长。
STARTUP_TIMEOUT=900

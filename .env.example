# 对外 API 端口
API_PORT=8880

# 官方镜像标签。生产环境建议替换为经过验证的固定版本标签。
API_IMAGE_TAG=latest-nvidia-gpu
VLM_IMAGE_TAG=latest-nvidia-gpu

# PP-DocLayoutV3 和文档预处理使用的物理 GPU。
PIPELINE_GPU_ID=4

# VLM 使用的物理 GPU，数量必须与 VLM_DATA_PARALLEL_SIZE 一致。
VLM_GPU_IDS=5,6
VLM_DATA_PARALLEL_SIZE=2
VLM_DATA_PARALLEL_BACKEND=mp

VLM_MODEL=PaddleOCR-VL-1.6-0.9B
VLM_GPU_MEMORY_UTILIZATION=0.8
VLM_MAX_NUM_SEQS=16
VLM_MAX_NUM_BATCHED_TOKENS=16384

# 模型首次下载或加载可能耗时较长。
STARTUP_TIMEOUT=900
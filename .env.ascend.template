# 复制本文件为 .env.ascend 后，使用 CONTRACTLENS_PLATFORM=ascend 运行统一 Compose。
# 独立运行 CLI/FastAPI 时请改为可访问的 PaddleX 地址；Compose 内部使用服务 DNS。
PDF_PARSER_ENDPOINT=http://192.168.0.194:8080
PDF_PARSER_TIMEOUT_SECONDS=120
PDF_PARSER_RETRIES=2
PDF_PARSER_CONCURRENCY=1
PDF_PARSER_USE_LAYOUT_DETECTION=true
PDF_PARSER_LAYOUT_THRESHOLD=0.5
PDF_PARSER_TRUST_ENV=false
PDF_PARSER_PORT=8888
PDF_PARSER_TMPFS_SIZE=2g
PDF_PARSER_ASCEND_DOCKERFILE=Dockerfile.ascend
PDF_PARSER_ASCEND_IMAGE=pdf-parser:ascend-ubuntu22.04
ASCEND_BASE_IMAGE=ubuntu:22.04

# PaddleOCR-VL 推理模块：以下默认值与导入的 paddleocr-server 昇腾示例保持一致。
API_PORT=8880
ASCEND_API_IMAGE_TAG=latest-huawei-npu
ASCEND_VLM_IMAGE_TAG=latest-huawei-npu
PADDLEX_CACHE_DIR=/home/mineru_dev/.paddlex
# 模式切换为 single 或 replicas 时使用以下分卡配置。
PIPELINE_NPU_ID=7
VLM_NPU_IDS=4,5,6
VLM_DATA_PARALLEL_SIZE=3
VLM_DATA_PARALLEL_BACKEND=mp
VLM_MODEL=PaddleOCR-VL-1.6-0.9B
VLM_GPU_MEMORY_UTILIZATION=0.3
VLM_MAX_NUM_SEQS=16
VLM_MAX_NUM_BATCHED_TOKENS=16384
STARTUP_TIMEOUT=900

# 四卡共卡：每张卡一个 PaddleX worker 和一个 vLLM rank，共用 vLLM DP4 API Server。
CONTRACTLENS_PIPELINE_MODE=colocated
CONTRACTLENS_COLOCATED_NPU_IDS=4,5,6,7
# 若运行时可见编号与物理卡号不同，按相同的物理卡顺序修改这两行。
CONTRACTLENS_COLOCATED_PIPELINE_RT_IDS=4,5,6,7
CONTRACTLENS_COLOCATED_VLM_RT_IDS=4,5,6,7
# 普通 replicas 模式的 worker 数。
CONTRACTLENS_PIPELINE_WORKERS=2
PIPELINE_SUBGRAPH_CONCURRENCY=16
# 官方多架构镜像；正式部署可替换为目标架构或多架构索引的 digest。
PIPELINE_PROXY_IMAGE=nginx:1.29.7-alpine

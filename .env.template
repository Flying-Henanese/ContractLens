# 复制本文件为 .env 后按部署环境修改。
# 本地 CLI 或独立运行 FastAPI 时使用的 PaddleX layout-parsing 服务根地址，
# 不要包含 /layout-parsing 或 /health 路径。统一 Compose 内部使用下方的
# PDF_PARSER_DOCKER_ENDPOINT，而不是该变量。
PDF_PARSER_ENDPOINT=http://192.168.0.194:8080

# 统一 Compose 内部的 PaddleX 服务发现地址（容器端口，不是宿主机 API_PORT）。
PDF_PARSER_DOCKER_ENDPOINT=http://paddleocr-vl-api:8080

# 单次远端请求超时（秒）。
PDF_PARSER_TIMEOUT_SECONDS=120

# 传输错误和超时的重试次数。
PDF_PARSER_RETRIES=2

# 同时提交到远端服务的页数。
PDF_PARSER_CONCURRENCY=1

# 显式启用版面检测，以便返回 layout_det_res 及检测框 score。
PDF_PARSER_USE_LAYOUT_DETECTION=true

# 版面检测置信度阈值；0.5 是可调默认值，并非所有文档的最优值。
PDF_PARSER_LAYOUT_THRESHOLD=0.5

# 是否继承系统 HTTP(S) 代理；访问内网服务时通常保持 false。
PDF_PARSER_TRUST_ENV=false

# Compose 镜像设置。默认使用 CUDA Dockerfile；昇腾宿主机改为 Dockerfile.ascend 和对应镜像名。
PDF_PARSER_DOCKERFILE=Dockerfile
PDF_PARSER_IMAGE=pdf-parser:cuda12.2
PDF_PARSER_PORT=8888
PDF_PARSER_TMPFS_SIZE=2g

# Dockerfile.ascend 的基础镜像；默认 Ubuntu 镜像同时支持 amd64 和 arm64。
ASCEND_BASE_IMAGE=ubuntu:22.04
PDF_PARSER_ASCEND_DOCKERFILE=Dockerfile.ascend
PDF_PARSER_ASCEND_IMAGE=pdf-parser:ascend-ubuntu22.04

# PaddleOCR-VL 推理模块。设备编号与现有 paddleocr-server 配置保持一致；
# 运行时入口会校验 VLM 设备数和数据并行副本数。
API_PORT=8880
VLM_PORT=8118
API_IMAGE_TAG=latest-nvidia-gpu
VLM_IMAGE_TAG=latest-nvidia-gpu
PIPELINE_GPU_ID=4
VLM_GPU_IDS=5,6
VLM_DATA_PARALLEL_SIZE=2
VLM_DATA_PARALLEL_BACKEND=mp
VLM_MODEL=PaddleOCR-VL-1.6-0.9B
VLM_GPU_MEMORY_UTILIZATION=0.8
VLM_MAX_NUM_SEQS=16
VLM_MAX_NUM_BATCHED_TOKENS=16384
STARTUP_TIMEOUT=900

# PaddleX 模型缓存所在的宿主机目录。请按目标服务器实际路径设置，切勿清理此目录。
PADDLEX_CACHE_DIR=/home/mineru_dev/.paddlex

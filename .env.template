# 复制本文件为 .env 后按部署环境修改。
# 远端 PaddleX layout-parsing 服务根地址，不要包含 /layout-parsing 或 /health。
PDF_PARSER_ENDPOINT=http://192.168.0.67:8880

# 单次 PaddleX 请求超时（秒）、传输重试次数及并行页数。
PDF_PARSER_TIMEOUT_SECONDS=120
PDF_PARSER_RETRIES=2
PDF_PARSER_CONCURRENCY=1

# 版面检测配置。layoutThreshold 是版面检测阈值，不是印章 OCR 置信度阈值。
PDF_PARSER_USE_LAYOUT_DETECTION=true
PDF_PARSER_LAYOUT_THRESHOLD=0.5

# 是否继承系统 HTTP(S) 代理；访问内网服务时通常保持 false。
PDF_PARSER_TRUST_ENV=false

# 可选的印章 VLM 兜底，生产默认关闭。
# 地址填写 OpenAI 兼容服务的根地址，不要包含 /v1/chat/completions。
PDF_PARSER_VLM_ENABLED=false
PDF_PARSER_VLM_ENDPOINT=http://192.168.0.194:8000
PDF_PARSER_VLM_MODEL=qwen3.6-27b

# 每次 VLM 请求超时 30 秒；每个视图最多尝试 5 次，两个视图最多并行请求 2 个。
PDF_PARSER_VLM_TIMEOUT_SECONDS=30
PDF_PARSER_VLM_MAX_ATTEMPTS=5
PDF_PARSER_VLM_CONCURRENCY=2

# 仅已检测印章的 OCR 文字为空、缺分数或任一文字分数低于此值时触发。
PDF_PARSER_VLM_SEAL_OCR_THRESHOLD=0.9

# Compose 镜像设置。默认使用 CUDA Dockerfile；昇腾宿主机改为 Dockerfile.ascend 和对应镜像名。
PDF_PARSER_DOCKERFILE=Dockerfile
PDF_PARSER_IMAGE=pdf-parser:cuda12.2
PDF_PARSER_PORT=8888
PDF_PARSER_TMPFS_SIZE=2g

# Dockerfile.ascend 的基础镜像；默认 Ubuntu 镜像同时支持 amd64 和 arm64。
ASCEND_BASE_IMAGE=ubuntu:22.04
